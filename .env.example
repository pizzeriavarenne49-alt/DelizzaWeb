# Delizza public website configuration
# Never commit real secret values in this file.

# Public canonical site
NEXT_PUBLIC_SITE_URL=https://www.delizza.fr
# Seasonal appearance requires exact agreement with server WL_APP_ID.
# Missing/different IDs disable seasonal effects; there is no Delizza fallback.
NEXT_PUBLIC_WL_APP_ID=d_lizza

# Firebase Client SDK (public browser config from the WLHORIZON Firebase project)
NEXT_PUBLIC_FIREBASE_API_KEY=your-public-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# Firebase App Check - reCAPTCHA Enterprise public site key
# Required in production because callable Functions enforce App Check.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-enterprise-site-key

# Stripe public key for the existing WLHORIZON live Stripe account.
# Must be the live publishable key that matches the backend STRIPE_SECRET_KEY.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx

# Coming Soon / maintenance lock
# Keep true until manual real-world acceptance testing is complete.
NEXT_PUBLIC_COMING_SOON=true

# Optional analytics and acquisition measurement.
# Both GA4 and the internal collector stay inactive until the visitor grants
# the corresponding optional purpose in the site preference dialog.
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_MARKETING_SOURCE_ID=delizza-web-production
# NEXT_PUBLIC_MARKETING_ENABLED=true
# Version of the privacy notice shown when the visitor makes the choice.
# A deployed server source must return the exact same consentRevision.
# NEXT_PUBLIC_MARKETING_CONSENT_REVISION=2026-10-12
# Development/isolated tests are disabled by default. Never set this in a
# public preview unless its Firebase App Check setup is intentionally isolated.
# NEXT_PUBLIC_MARKETING_TEST_MODE=true
# In this mode the client refuses every project except this isolated emulator
# project and connects Auth/Firestore/Functions to 9909/9808/9501.
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-acquisition-marketing

# Seasonal appearance also requires FIREBASE_PROJECT_ID to match
# NEXT_PUBLIC_FIREBASE_PROJECT_ID. Both IDs must be present at build/runtime.
# Server-side Firebase Admin config for static catalogue rendering.
# Use only deployment environment variables or local private env files.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
WL_APP_ID=d_lizza

# Optional Directus fallback for local development only.
# Do not use a localhost CMS URL in production.
# NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
# DIRECTUS_STATIC_TOKEN=your-token-here

# Backend secrets live in WLHORIZON / Firebase Functions secrets, not here:
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# STRIPE_PUBLISHABLE_KEY
